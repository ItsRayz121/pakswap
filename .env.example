# ============================================================
# PAKSWAP — ENVIRONMENT VARIABLES REFERENCE
# ============================================================
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# All secrets must be stored in AWS Secrets Manager in production.
# See Doc 11 (11_TECH_STACK_DECISIONS.md) for stack context.
# ============================================================

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NODE_ENV=development                        # development | staging | production
APP_PORT=3000
APP_URL=http://localhost:3000               # Full URL (used in email links, CORS)
ADMIN_URL=http://localhost:3001             # Admin panel URL

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
JWT_SECRET=                                 # Min 64 chars random string. DIFFERENT from admin secret.
JWT_ACCESS_EXPIRY=900                       # Seconds (15 minutes)
JWT_REFRESH_EXPIRY=2592000                  # Seconds (30 days)

ADMIN_JWT_SECRET=                           # Min 64 chars. DIFFERENT from user JWT secret.
ADMIN_JWT_EXPIRY=28800                      # Seconds (8 hours)

BCRYPT_ROUNDS=12                            # Cost factor for password hashing (12 recommended)

ENCRYPTION_KEY=                             # 32-byte hex — AES-256 for encrypting PII at rest

# ------------------------------------------------------------
# DATABASE — PostgreSQL
# ------------------------------------------------------------
DATABASE_URL=postgresql://pakswap:password@localhost:5432/pakswap
DATABASE_URL_READ=postgresql://pakswap:password@localhost:5432/pakswap  # Read replica in prod
PGBOUNCER_URL=postgresql://pakswap:password@localhost:6432/pakswap      # Use this in app

# ------------------------------------------------------------
# CACHE — Redis
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                             # Leave blank for local dev; required in production

# ------------------------------------------------------------
# EMAIL — SendGrid
# ------------------------------------------------------------
SENDGRID_API_KEY=                           # SG.xxxx
SENDGRID_FROM_EMAIL=noreply@pakswap.com
SENDGRID_FROM_NAME=PakSwap
SENDGRID_REPLY_TO=support@pakswap.com

# SendGrid Dynamic Template IDs (create in SendGrid dashboard)
SENDGRID_TEMPLATE_WELCOME=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_KYC_SUBMITTED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_KYC_APPROVED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_KYC_REJECTED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_TRADE_COMPLETE_BUYER=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_TRADE_COMPLETE_SELLER=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_DISPUTE_OPENED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_DISPUTE_RESOLVED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_LOGIN_ALERT=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_IB_ORDER_CREATED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_IB_ORDER_COMPLETE=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_IB_PAYMENT_REJECTED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# SMS — Twilio
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx             # Or Twilio messaging service SID

# ------------------------------------------------------------
# FILE STORAGE — AWS S3
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1                       # Mumbai (closest to Pakistan with S3)

S3_BUCKET_KYC=pakswap-kyc-documents-prod   # Private bucket — KYC documents, selfies
S3_BUCKET_SCREENSHOTS=pakswap-screenshots-prod  # Private bucket — payment proofs
S3_PRESIGNED_URL_EXPIRY=300                 # Seconds (5 minutes) — for admin viewing

# ------------------------------------------------------------
# OCR — Google Cloud Vision
# ------------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json  # Path to service account key

# PaddleOCR (self-hosted fallback)
PADDLEOCR_SERVICE_URL=http://localhost:8080  # Internal service URL

# ------------------------------------------------------------
# KYC AI — Free/Open-Source Services
# ------------------------------------------------------------
# DeepFace — runs as a local Python microservice
DEEPFACE_SERVICE_URL=http://localhost:8081

# MediaPipe liveness — runs as a local Python microservice
LIVENESS_SERVICE_URL=http://localhost:8082

# ------------------------------------------------------------
# BLOCKCHAIN RPC PROVIDERS
# ------------------------------------------------------------

# Ethereum (Primary: Infura | Fallback: Alchemy)
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETH_RPC_FALLBACK_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_CHAIN_ID=1

# BSC / BNB Chain (Primary: Ankr | Fallback: Alchemy)
BSC_RPC_URL=https://rpc.ankr.com/bsc/YOUR_ANKR_KEY
BSC_RPC_FALLBACK_URL=
BSC_CHAIN_ID=56

# Solana (Primary: Helius WebSocket)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# TRON (Primary: TronGrid — USDT TRC-20)
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=

# Bitcoin (BlockCypher webhooks)
BLOCKCYPHER_API_KEY=
BLOCKCYPHER_WEBHOOK_URL=https://api.pakswap.com/webhooks/blockcypher  # Must be HTTPS

# Polygon (Ankr)
POLYGON_RPC_URL=https://rpc.ankr.com/polygon/YOUR_ANKR_KEY
POLYGON_CHAIN_ID=137

# Avalanche (Ankr)
AVAX_RPC_URL=https://rpc.ankr.com/avalanche/YOUR_ANKR_KEY
AVAX_CHAIN_ID=43114

# TON
TON_API_URL=https://toncenter.com/api/v2
TON_API_KEY=

# ------------------------------------------------------------
# HOT WALLET — AWS KMS (Signing Service)
# ------------------------------------------------------------
# The signing service is an isolated Node.js process.
# It communicates with the main API via mTLS only.
# Private keys are NEVER in environment variables — they live in KMS.
SIGNING_SERVICE_URL=https://signing.internal.pakswap.com
SIGNING_SERVICE_MTLS_CERT=./certs/client.crt
SIGNING_SERVICE_MTLS_KEY=./certs/client.key

# KMS Key ARNs (one per blockchain)
KMS_KEY_ARN_ETH=arn:aws:kms:ap-south-1:xxxx:key/xxxx
KMS_KEY_ARN_BSC=arn:aws:kms:ap-south-1:xxxx:key/xxxx
KMS_KEY_ARN_TRON=arn:aws:kms:ap-south-1:xxxx:key/xxxx
KMS_KEY_ARN_SOL=arn:aws:kms:ap-south-1:xxxx:key/xxxx
KMS_KEY_ARN_BTC=arn:aws:kms:ap-south-1:xxxx:key/xxxx

# Hot wallet addresses (public, for deposit monitoring)
HOT_WALLET_ETH=0x
HOT_WALLET_BSC=0x
HOT_WALLET_TRON=T
HOT_WALLET_SOL=
HOT_WALLET_BTC=bc1

# ------------------------------------------------------------
# FIREBASE — Push Notifications
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=                       # From Firebase service account JSON (include newlines as \n)
FIREBASE_CLIENT_EMAIL=

# ------------------------------------------------------------
# ADMIN ALERTS — Slack
# ------------------------------------------------------------
SLACK_WEBHOOK_URL=                          # Incoming webhook URL for admin alerts channel
SLACK_CHANNEL_ALERTS=#pakswap-alerts
SLACK_CHANNEL_FRAUD=#pakswap-fraud

# ------------------------------------------------------------
# MONITORING
# ------------------------------------------------------------
SENTRY_DSN=                                 # https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=development              # development | staging | production

# Prometheus metrics endpoint (internal only)
METRICS_PORT=9090
METRICS_SECRET=                             # Bearer token for /metrics endpoint

# ------------------------------------------------------------
# RATE LIMITING CONFIGURATION
# See Doc 13 for the full rate limit reference.
# These override defaults for non-production environments.
# ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_RPM=300                   # Requests per minute per user (production: 300)
RATE_LIMIT_LOGIN_ATTEMPTS=5                 # Failed login attempts before lockout
RATE_LIMIT_OTP_PER_HOUR=5                   # SMS OTPs per phone per hour

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
FEATURE_INSTANT_BUY=true                    # Enable/disable Instant Buy feature
FEATURE_MERCHANT_PROVIDERS=false            # Enable merchant inventory providers (Phase 2)
FEATURE_CRYPTO_TO_CRYPTO=false              # Enable Mode B Instant Buy (Phase 2)
FEATURE_REFERRAL=true
FEATURE_DISPUTES=true
FEATURE_MAINTENANCE_MODE=false              # If true: all user API calls return 503

# ------------------------------------------------------------
# BUSINESS RULES (can be overridden without code change)
# ------------------------------------------------------------
P2P_TAKER_FEE_RATE=0.005                    # 0.5% — standard taker fee
P2P_MERCHANT_FEE_RATE=0.003                 # 0.3% — verified merchant fee
TRADE_PAYMENT_WINDOW_SECONDS=900            # 15 minutes buyer payment window
TRADE_RELEASE_WINDOW_SECONDS=900            # 15 minutes seller release window after approval
IB_QUOTE_EXPIRY_SECONDS=600                 # 10 minutes Instant Buy quote lock
KYC_LEVEL1_DAILY_LIMIT_PKR=50000
KYC_LEVEL2_DAILY_LIMIT_PKR=500000
MAX_SIMULTANEOUS_TRADES=3
MAX_SIMULTANEOUS_IB_ORDERS=3
MAX_IB_ORDERS_PER_DAY=10

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001  # Comma-separated

# ------------------------------------------------------------
# INTERNAL SERVICE COMMUNICATION
# ------------------------------------------------------------
# Used when blockchain monitor, OCR service, and payout service
# call back into the main API
INTERNAL_API_SECRET=                        # Shared secret for internal service-to-service calls
