{
  "name": "pakswap-backend",
  "version": "1.0.0",
  "description": "PakSwap P2P Crypto Exchange — Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "npx prisma db push && node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.16.0",
    "@sendgrid/mail": "^8.1.3",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.0",
    "ethers": "^6.13.1",
    "fast-levenshtein": "^3.0.0",
    "fastify": "^4.28.1",
    "firebase-admin": "^12.2.0",
    "ioredis": "^5.4.1",
    "otplib": "^12.0.1",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1",
    "qrcode": "^1.5.4",
    "resend": "^4.8.0",
    "sharp": "^0.33.4",
    "tronweb": "^5.3.2",
    "twilio": "^5.2.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.16.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
